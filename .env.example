# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real tokens.

# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Canvas personal access token.
# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
CANVAS_API_TOKEN=

# Your Canvas instance. CMU students can leave this as-is.
CANVAS_BASE_URL=https://canvas.cmu.edu

# --- Optional overrides (defaults shown) ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# CANVAS_ASSISTANT_DB=canvas_assistant.db
