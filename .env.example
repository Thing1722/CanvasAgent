# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real tokens.

# Which LLM to use: deepseek | openai | anthropic
# The app does not fall back to another provider if this one fails.
LLM_PROVIDER=deepseek

# Model name for the selected provider.
# DeepSeek defaults to deepseek-flash when this is omitted.
# OpenAI and Anthropic require LLM_MODEL.
LLM_MODEL=deepseek-flash

# API key for the selected provider only. Unused keys can stay blank.
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Canvas personal access token.
# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
CANVAS_API_TOKEN=

# Your Canvas instance. CMU students can leave this as-is.
CANVAS_BASE_URL=https://canvas.cmu.edu

# --- Optional overrides (defaults shown) ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Older DeepSeek-only configs can still set DEEPSEEK_MODEL instead of LLM_MODEL.
# DEEPSEEK_MODEL=deepseek-flash
# CANVAS_ASSISTANT_DB=canvas_assistant.db
# IANA timezone for due dates shown to you and to the assistant.
# Defaults to Pittsburgh / Eastern. Do not use a fixed UTC-5 offset.
# CANVAS_ASSISTANT_TZ=America/New_York
